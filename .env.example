# Copy this file to ".env" and fill it in.

# The Gmail account the alerts are sent FROM. Create a free one just for this
# if you like; it doesn't have to be your main address.
SMTP_USER=yourname.househunter@gmail.com
# A Gmail "app password" (16 letters), NOT your normal password.
# Make one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
SMTP_PASSWORD=abcdefghijklmnop

# Where the alerts go. Any address works, including Outlook/Hotmail or your uni email.
EMAIL_TO=you@example.com

# Only change these if you're not sending from Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
